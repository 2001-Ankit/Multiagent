OPENAI_API_KEY=your_openai_api_key_here
EMAIL_ADDRESS=your_email_address_here
EMAIL_PASSWORD=your_email_password_here
DELIVERY_EMAIL_TO=recipient_email_address_here
GROQ_API_KEY=your_groq_api_key_here
# Bigger model = smarter agents. Try openai/gpt-oss-120b or llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-20b

# Optional: a short "about me" given to every agent for personalized answers.
# If blank, data/profile.md is used instead.
USER_PROFILE=
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Delivery: "email" (default), "telegram", "whatsapp", or "discord"
DELIVERY_CHANNEL=email

# Discord (fast from Nepal, no business account needed).
# Delivery: create a channel webhook and paste its URL here.
DISCORD_WEBHOOK_URL=
# Two-way bot: a bot token from discord.com/developers (enable Message Content Intent).
DISCORD_BOT_TOKEN=
# Your Discord user id, so only you can drive the bot (optional but recommended).
DISCORD_ALLOWED_USER_ID=

# WhatsApp Cloud API (Meta) - fast + reliable from Nepal. Outbound delivery.
# From developers.facebook.com: create an app, add WhatsApp, copy these.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TO=9779800000000
WHATSAPP_API_VERSION=v21.0
# Two-way WhatsApp bot (webhook). Pick any string for the verify token; you enter
# the SAME string in Meta's webhook config. Port is where the local server listens.
WHATSAPP_VERIFY_TOKEN=pick_any_secret_string
WHATSAPP_BOT_PORT=8000

# Telegram bot delivery (create a bot via @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Used by job/travel/scholarship/learning agents (your country / passport)
CANDIDATE_COUNTRY=Nepal
# Default items for the "watch" briefing (price_watch agent)
PRICE_WATCHLIST=BTC target 60000 or below; AAPL; NVDA
# Optional: point at a resume file directly (otherwise data/resume/ or src/resume/)
RESUME_PATH=

# Optional: Indeed via a runnable MCP jobs server (extra reach on top of web search).
# Use ONE transport. Leave both blank to rely on web search only.
#   stdio:  INDEED_MCP_COMMAND="npx -y your-indeed-mcp-server"
#   http:   INDEED_MCP_URL=https://your-indeed-mcp-host/mcp  (+ INDEED_MCP_TOKEN)
INDEED_MCP_COMMAND=
INDEED_MCP_URL=
INDEED_MCP_TOKEN=
INDEED_MCP_SEARCH_TOOL=search_jobs
