OPENAI_API_KEY=your_openai_api_key_here
EMAIL_ADDRESS=your_email_address_here
EMAIL_PASSWORD=your_email_password_here
DELIVERY_EMAIL_TO=recipient_email_address_here
GROQ_API_KEY=your_groq_api_key_here
# Default is llama-3.3-70b-versatile (reliable tool-calling). Avoid gpt-oss-* on
# Groq for the agents - they intermittently break tool calls.
GROQ_MODEL=llama-3.3-70b-versatile

# Main "brain" LLM (any OpenAI-compatible endpoint). Leave blank to use Groq above.
# To switch the brain to NVIDIA (e.g. Kimi K2.6 - 1T params, 262K context, tool use):
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=moonshotai/kimi-k2.6
#   LLM_API_KEY=nvapi-your-key
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Automatic model fallback. Provider quotas are PER MODEL, so when the primary hits
# its daily limit the next one still has budget. Tried in order, left to right.
LLM_FALLBACK_MODELS=llama-3.1-8b-instant,openai/gpt-oss-120b
# If NVIDIA_API_KEY is set, this is appended as a final cross-provider fallback
# (a completely separate quota pool). Must be a model your account can access AND
# that supports tool calling - verify before changing.
LLM_FALLBACK_NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Search resilience (DuckDuckGo rate-limits bursts, especially during a swarm).
SEARCH_MIN_INTERVAL=1.2
SEARCH_MAX_RETRIES=3
SEARCH_CACHE_TTL=900

# Hard cap on how many agents a single plan may use.
MAX_SWARM_AGENTS=3

# Token control. An agent re-sends its whole history each round, so raw tool output
# dominates cost. Lower these if you keep hitting daily quota; raise for more depth.
MAX_TOOL_RESULT_CHARS=1500   # max size of one tool result kept in context
TOOL_HISTORY_KEEP_FULL=2     # older tool results are collapsed to a stub
DAILY_TOKEN_BUDGET=100000    # your provider's tokens-per-day limit
SWARM_BUDGET_FRACTION=0.6    # past this fraction, swarms downgrade to a single agent

# A swarm costs roughly 3x a solo run, so it is opt-in by default: it fans out only
# when you ask for one ("swarm", "deep dive", "pros and cons", "multiple angles").
# Set to 0 to let the planner decide on its own, as it used to.
SWARM_OPT_IN_ONLY=1

# NVIDIA vision model for image/chart analysis (vision_agent). OpenAI-compatible.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional: a short "about me" given to every agent for personalized answers.
# If blank, data/profile.md is used instead.
USER_PROFILE=
# Finance data now uses Yahoo Finance (yfinance) - no API key needed.
# ALPHA_VANTAGE_API_KEY is no longer required.

# Delivery: "email" (default), "telegram", "whatsapp", or "discord"
DELIVERY_CHANNEL=email

# Discord (fast from Nepal, no business account needed).
# Delivery: create a channel webhook and paste its URL here.
DISCORD_WEBHOOK_URL=
# Two-way bot: a bot token from discord.com/developers (enable Message Content Intent).
DISCORD_BOT_TOKEN=
# Your Discord user id, so only you can drive the bot (optional but recommended).
DISCORD_ALLOWED_USER_ID=

# Built-in scheduler (runs inside the bot - no cron/Task Scheduler needed).
# Blank = disabled. Examples: "07:30"  or  "07:30=daily,19:00=news,09:00=watch"
BRIEFING_SCHEDULE=
BRIEFING_NAME=daily
TIMEZONE=Asia/Kathmandu

# WhatsApp Cloud API (Meta) - fast + reliable from Nepal. Outbound delivery.
# From developers.facebook.com: create an app, add WhatsApp, copy these.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_TO=9779800000000
WHATSAPP_API_VERSION=v21.0
# Two-way WhatsApp bot (webhook). Pick any string for the verify token; you enter
# the SAME string in Meta's webhook config. Port is where the local server listens.
WHATSAPP_VERIFY_TOKEN=pick_any_secret_string
WHATSAPP_BOT_PORT=8000

# Telegram bot delivery (create a bot via @BotFather, then get your chat id)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# How many agents may run at once in parallel/swarm mode. Higher = faster but far
# more tokens per minute (more rate-limit retries on free tiers).
SWARM_MAX_WORKERS=3
# Reviewer pass over merged swarm answers (parallel mode only).
ENABLE_CRITIC=true
# Local run tracing to logs/runs.jsonl (view with --stats). Set false to disable.
RUN_TRACING=true

# Blog repo pull requests. When these are set, /content and /blog open a PR in your
# blog repo instead of only saving a local draft. A PR is a proposal - the post goes
# live only when you merge it.
# Token: a fine-grained PAT scoped to the blog repo with
#   Contents: read/write  +  Pull requests: read/write
GITHUB_TOKEN=
BLOG_REPO=owner/repo
BLOG_POSTS_PATH=src/content/blog
BLOG_BASE_BRANCH=main

# Direct publishing to the Astro site. `/publish <id>` converts the post into the
# Astro schema, commits and pushes it, and Vercel redeploys - no PR, no manual git.
# BLOG_SITE_DIR is relative to the project root unless it is an absolute path.
BLOG_SITE_DIR=blog-site
BLOG_SITE_BRANCH=main

# Blog / static site (the built-in Python generator; unused if you use the Astro app)
BLOG_TITLE=Ankit Rai
BLOG_TAGLINE=Notes on tech, markets, and studying abroad
BLOG_AUTHOR=Ankit Rai
# Public site address - used for absolute links in RSS and sitemap.
BLOG_URL=

# Conversation memory: remembers recent turns so follow-ups resolve
# ("tell me more about the second one"). History is sent to the planner only.
ENABLE_MEMORY=true
MEMORY_MAX_TURNS=4
MEMORY_MAX_ANSWER_CHARS=500

# Used by job/travel/scholarship/learning agents (your country / passport)
CANDIDATE_COUNTRY=Nepal
# Default items for the "watch" briefing (price_watch agent)
PRICE_WATCHLIST=BTC target 60000 or below; AAPL; NVDA
# Optional: point at a resume file directly (otherwise data/resume/ or src/resume/)
RESUME_PATH=

# Optional: Indeed via a runnable MCP jobs server (extra reach on top of web search).
# Use ONE transport. Leave both blank to rely on web search only.
#   stdio:  INDEED_MCP_COMMAND="npx -y your-indeed-mcp-server"
#   http:   INDEED_MCP_URL=https://your-indeed-mcp-host/mcp  (+ INDEED_MCP_TOKEN)
INDEED_MCP_COMMAND=
INDEED_MCP_URL=
INDEED_MCP_TOKEN=
INDEED_MCP_SEARCH_TOOL=search_jobs

# Google Gemini as a third fallback provider. This is an AI Studio API key from
# aistudio.google.com - NOT your Gemini Pro / Google AI Pro subscription, which
# has no API. Check AI Studio for the current model ids before changing this.
GEMINI_API_KEY=
LLM_FALLBACK_GEMINI_MODEL=gemini-2.5-flash

# Route CONTENT generation through the Gemini CLI, which signs in with your Google
# account instead of an API key - so a Google AI Pro subscription is usable here even
# though it has no REST API. Text only: the specialist agents need tool calling and
# stay on the OpenAI-compatible chain regardless of this setting.
# Requires: npm i -g @google/gemini-cli, then `gemini` once to sign in.
USE_GEMINI_CLI=0
# Workspace / Code-Assist accounts must also set a Cloud project id.
GOOGLE_CLOUD_PROJECT=
GEMINI_CLI_MODEL=
GEMINI_CLI_TIMEOUT=180

# Vertex AI: the image route when a Workspace admin blocks AI Studio key creation.
# Uses Application Default Credentials, so there is no key to leak: locally run
# `gcloud auth application-default login`; on a GCP VM the attached service
# account is used automatically. Bills against your Cloud project.
VERTEX_LOCATION=us-central1
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image

# Generate a cover automatically with each /blog draft. The image is named after
# the draft slug, so publishing wires it into the frontmatter with no extra step.
# Set to 0 if you would rather make covers by hand.
BLOG_AUTO_COVER=1
# Override the cover look without touching code.
COVER_STYLE=

# Daily interview practice. Create a #interview channel in Discord, add a webhook
# to it, and paste the URL here so practice lands there instead of the main channel.
DISCORD_INTERVIEW_WEBHOOK_URL=
# The role the questions are pitched at.
INTERVIEW_ROLE=mid-level AI engineer

# Channel routing. A channel whose name contains a mode (interview, blog,
# content, news, jobs) only handles that mode. Unlisted channels accept
# everything, so one general channel still works.
# Map extra names: DISCORD_CHANNEL_MODES="writing:blog,ai-daily:news"
DISCORD_CHANNEL_MODES=
# Per-briefing channels, all optional - unset falls back to the main channel.
DISCORD_AI_WEBHOOK_URL=
DISCORD_NEWS_WEBHOOK_URL=
DISCORD_DAILY_WEBHOOK_URL=

# GitHub trending repos (Dev Radar). Unauthenticated search is 10/minute;
# GITHUB_TOKEN raises it to 30 and removes the built-in throttling.
GITHUB_TREND_MIN_STARS=150

# University shortlist CSV (academic tracker). Defaults to data/academic/.
UNIVERSITY_CSV=
