wheels/
*.egg-info

# Virtual environments
.venv


.env
credentials.json
token.json

# Only the credentials live outside git - the code must be committed or a
# fresh clone cannot import it and the app will not start.
/src/delivery_agent/credentials/

# Private resume files (keep the folder + its README only)
/data/resume/*
!/data/resume/README.md
/src/resume/

# Private user profile (personal info given to the agents)
/data/profile.md
# Local run traces and bot logs
/logs/

# Conversation memory (private)
/data/memory/

# blog-site/ is a SEPARATE repo (github.com/2001-Ankit/agenticblog) with its own
# Vercel deploy. Never let it be staged here as a nested gitlink.
/blog-site/

# Generated static output from the old Pages build
/site/

# Rendered slide images - regenerate from the deck JSON with render_slides
/data/social/slides/

# Uploaded scene media (build inputs, regenerate or re-upload as needed)
/data/social/scenes/
